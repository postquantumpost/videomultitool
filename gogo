#!/usr/bin/env bash

./videomultitool.py --help

# ./videomultitool.py --help
# usage: videomultitool.py [-h] [--debug] [--debug2] [--nobluredge] [--fill] [--blur | --blankless]
#                          [--alacarte LIST] [--input FILE] [--output FILE]
#
# Operate on video files.
#
# options:
#   -h, --help       show this help message and exit
#   --debug          enable debug output
#   --debug2         enable second-level debug (random test blur boxes)
#   --nobluredge     do not extend the blur with a fade beyond each box edge
#   --fill           fill each box with its average colour instead of blurring it
#   --blur           blur detected faces, nudity and license plates (needs --input and --output)
#   --blankless      crop letterbox/pillarbox borders (needs --input and --output)
#   --alacarte LIST  blur using only comma-separated
#                    retinaface,deepface,nudenet,hyperlpr,fastanpr,debug2; an empty string copies the
#                    file unchanged (needs --input and --output)
#   --input FILE     input video file
#   --output FILE    output video file

process_file()
{
    local f=$1
    echo ''
    echo ''
    #echo $f
    fshort=${f##*/}
    #echo $fshort
    fbase=${fshort%%.*}
    #echo $fbase
    fout=${fbase}.mp4
    #echo $fout
    #echo ./videomultitool.py --debug --blankless --input $f --output $fout
    #./videomultitool.py --debug --blankless --input $f --output $fout
    set -x
    #time ./videomultitool.py --debug --blur --input $f --output $fout
    #time ./videomultitool.py --debug --alacarte 'hyperlpr' --input $f --output $fout
    #time ./videomultitool.py --alacarte 'hyperlpr,nudenet' --input $f --output $fout
    time ./videomultitool.py --debug --alacarte 'fastanpr' --input $f --output $fout
    set +x
}

